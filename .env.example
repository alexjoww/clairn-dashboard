# Copy to .env.local and fill in values from your Cognito user pool.
#
# NEXT_PUBLIC_* variables are read at build time, so they must be set in the
# environment that runs `npm run build` — for Amplify Hosting that means the
# app's environment variables in the console, not just at deploy time.

# Cognito user pool ID, e.g. us-east-1_AbCdEfGhI
NEXT_PUBLIC_COGNITO_USER_POOL_ID=

# Cognito app client ID (the client must have no secret — this is a browser app)
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# API Gateway base URL for the document API, e.g.
# https://abc123.execute-api.us-east-1.amazonaws.com (add the stage if you use
# a named one). The app calls POST {this}/documents.
NEXT_PUBLIC_API_URL=
